daemon off;
user www-data;

# Railway reports the 48-core host, not the container's 8-CPU quota.
worker_processes 2;
error_log /dev/stderr notice;
pid /var/run/nginx-pms.pid;

events {
    worker_connections 2048;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    access_log /dev/stdout;
    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    server_tokens off;
    client_max_body_size 108M;
    absolute_redirect off;

    gzip on;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types text/css text/plain text/javascript application/javascript application/json application/xml image/svg+xml;

    # Railway's edge overwrites a client-supplied X-Forwarded-For, so the leftmost entry
    # is the real client. A right-to-left walk lands on the edge's own rotating address.
    map $http_x_forwarded_for $pms_real_ip {
        '~^\s*(?P<first>[^,\s]+)' $first;
        default $remote_addr;
    }

    map $http_x_forwarded_proto $pms_https {
        https on;
        default '';
    }

    server {
        listen ${PORT} default_server;
        listen [::]:${PORT} default_server;

        root /application/public;
        index index.php;

        # The SPA is a separate Railway service, so every API call is cross-origin, and
        # the app's own CORS headers do not survive two situations:
        #
        #   * Responses the security firewall produces never reach the kernel.response
        #     listener that adds them, so a successful POST /login came back with the JWT
        #     and no Access-Control-Allow-Origin at all - the browser discarded it and the
        #     login silently did nothing.
        #   * The app answers `Access-Control-Allow-Headers: *`, and the Fetch spec
        #     excludes `Authorization` from that wildcard. This SPA sets
        #     `Authorization: Bearer <token>` and a custom `Caller` header on *every*
        #     request, so every preflight failed and no call ever reached JavaScript.
        #
        # Strip whatever the app emitted and state these once here, on every response
        # including errors, naming Authorization explicitly. `*` is safe for the origin
        # because this API authenticates with a bearer token, never a cookie, so no
        # request is credentialed.
        fastcgi_hide_header Access-Control-Allow-Origin;
        fastcgi_hide_header Access-Control-Allow-Headers;
        fastcgi_hide_header Access-Control-Allow-Methods;
        fastcgi_hide_header Access-Control-Expose-Headers;
        add_header Access-Control-Allow-Origin   "*" always;
        add_header Access-Control-Allow-Headers  "Authorization, Caller, Content-Type, Accept, Origin, X-Requested-With, is-system-disabled, is-system-soon-disabled" always;
        add_header Access-Control-Allow-Methods  "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;
        add_header Access-Control-Expose-Headers "Authorization, is-system-disabled, is-system-soon-disabled" always;
        add_header Access-Control-Max-Age        "3600" always;
        add_header X-Content-Type-Options        "nosniff" always;

        # The SPA verifies every JWT signature against a public key baked into its
        # bundle, so it has to be told this deployment's key rather than the one upstream
        # commits. Serving a public key is safe by definition; the frontend container
        # reads it over the private network at boot.
        location = /jwt_public_key {
            default_type text/plain;
            alias /application/config/jwt/prod/public.pem;
        }

        # Dependency probe served from outside the docroot, on a path healthcheckPath
        # accepts (no '-' and no '.'). The app's own routes always answer 200 because a
        # kernel.response listener rewrites every status, so they prove nothing.
        location = /healthz {
            include fastcgi_params;
            fastcgi_pass 127.0.0.1:9000;
            fastcgi_param SCRIPT_FILENAME /opt/pms/healthz.php;
            fastcgi_param SCRIPT_NAME /healthz;
            fastcgi_param DOCUMENT_ROOT /opt/pms;
        }

        location / {
            try_files $uri /index.php$is_args$args;
        }

        location ~ ^/index\.php(/|$) {
            include fastcgi_params;
            fastcgi_pass 127.0.0.1:9000;
            fastcgi_split_path_info ^(.+\.php)(/.*)$;
            fastcgi_param SCRIPT_FILENAME $document_root/index.php;
            fastcgi_param DOCUMENT_ROOT $document_root;
            fastcgi_buffers 16 16k;
            fastcgi_buffer_size 32k;
            fastcgi_read_timeout 120s;
            internal;
        }

        # Nothing else in the docroot is a PHP entry point.
        location ~ \.php$ {
            return 404;
        }
    }
}
